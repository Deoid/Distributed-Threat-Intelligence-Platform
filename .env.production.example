# Production Environment Variables Example
# Copy to .env.production on your server

POSTGRES_DB=threatintel
POSTGRES_USER=threatintel_admin
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here

REDIS_PASSWORD=generate_a_secure_redis_password_here

IMAGE_PREFIX=ghcr.io/your-username/threat-intelligence-platform
IMAGE_TAG=latest

API_PORT=5000
COLLECTOR_PORT=5001
REDIS_CACHE_TTL=60
